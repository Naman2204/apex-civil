{
  "name": "exam-portal-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report .freebuff/playwright-report",
    "test:smoke": "playwright test e2e/smoke.spec.ts",
    "test:navigation": "playwright test e2e/navigation.spec.ts",
    "test:auth-flow": "playwright test e2e/auth-flow.spec.ts",
    "test:api": "playwright test e2e/api-security.spec.ts",
    "test:perf": "playwright test e2e/performance-a11y.spec.ts",
    "test:authenticated": "playwright test e2e/authenticated-flow.spec.ts --project=authenticated",
    "test:auth-dashboard": "playwright test e2e/authenticated-dashboard.spec.ts --project=authenticated",
    "test:strict-exam": "playwright test e2e/strict-exam-flow.spec.ts --project=authenticated",
    "test:ci": "playwright test --reporter=list,html",
    "test:ci:smoke": "playwright test e2e/smoke.spec.ts e2e/api-security.spec.ts --reporter=list"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.4",
    "@clerk/themes": "^2.4.57",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.26",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.61.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
